{
  "name": "cheffree",
  "version": "0.2.0",
  "description": "A web app for storing and sharing recipes.",
  "keywords": [
    "chef",
    "free",
    "recipe",
    "food",
    "cook",
    "cooking"
  ],
  "homepage": "https://github.com/FunhouseAtelier/cheffree#readme",
  "bugs": {
    "url": "https://github.com/FunhouseAtelier/cheffree/issues",
    "email": "funhouse_atelier@protonmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "author": {
    "name": "Jason T Szabo"
  },
  "repository": "github:FunhouseAtelier/cheffree",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "prisma generate && remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "psff": "npx prisma studio --browser firefox",
    "pdbp": "npx prisma db push",
    "pg": "npx prisma generate",
    "migrate-db": "node ./scripts/migrate-db.js"
  },
  "dependencies": {
    "@clerk/remix": "^4.2.29",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-regular-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@funhouse-atelier/logger": "^1.0.1",
    "@hello-pangea/dnd": "^17.0.0",
    "@prisma/client": "^5.20.0",
    "@remix-run/node": "^2.11.2",
    "@remix-run/react": "^2.11.2",
    "@remix-run/serve": "^2.11.2",
    "@types/luxon": "^3.4.2",
    "base-id": "^3.3.0",
    "isbot": "^4.1.0",
    "luxon": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remix-utils": "^7.7.0",
    "styled-components": "^6.1.13",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.11.2",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.1.6",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
